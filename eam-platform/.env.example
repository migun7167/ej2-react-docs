# ==== EAM Platform — local config ====
# คัดลอกเป็น .env แล้วแก้ค่า:  cp .env.example .env

# โดเมน/host ที่จะเข้าใช้งาน (Caddy ออก cert ให้อัตโนมัติ; ใช้ localhost ได้)
SITE_ADDRESS=localhost

HTTP_PORT=80
HTTPS_PORT=443

# Database
DB_PASSWORD=change-me-strong

# MinIO (object storage)
MINIO_USER=eamadmin
MINIO_PASSWORD=change-me-strong

# Auth
#   dev      = ไม่ต้องมี Keycloak — ผู้ใช้ demo จาก seed (ห้ามใช้ production)
#   keycloak = ตรวจ JWT จาก Keycloak (เปิด profile auth: docker compose --profile auth up -d)
AUTH_MODE=dev
KC_ADMIN_PASSWORD=admin
OIDC_ISSUER=https://localhost/auth/realms/eam

# Map tiles
#   dev เท่านั้น: OSM demo tiles (ห้าม production ตาม OSMF usage policy)
#   production: เปิด profile tiles + วาง thailand.mbtiles ใน ops/tiles/data
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Docker image tag
TAG=local
